## Blockscout (RSK) configuration for local dev

# Required for RSK-specific behavior
CHAIN_TYPE=rsk

# Web
PORT=4000

# Explorer metadata
NETWORK=Rootstock Regtest
SUBNETWORK=Local
COIN=RBTC

# Required Phoenix secret for session/cookies (dev-only, deterministic)
SECRET_KEY_BASE=4e7b3fd34e37dd9ee1864a75a5e6c26a4d7a1a4aa65c6d6f5f16c9265e22c5f9b85e64c8b9b7c5d5a7c2f2e7d6b8a4e3d2c1b0a9f8e7d6c5b4a3f2e1d0c

# Indexer tuning (keep it lightweight)
DISABLE_EXCHANGE_RATES=true
DISABLE_KNOWN_TOKENS=true

# Logging
LOG_LEVEL=${BLOCKSCOUT_LOG_LEVEL:-info}

# DB + JSON-RPC are set in docker-compose.yml so they can reference service names.

