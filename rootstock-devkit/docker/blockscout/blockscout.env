## Blockscout (RSK) configuration for local dev

# Required for RSK-specific behavior
CHAIN_TYPE=rsk

# Web
PORT=4000

# Explorer metadata
NETWORK=Rootstock Regtest
SUBNETWORK=Local
COIN=RBTC

# JSON-RPC client settings (required by Blockscout)
# RSKj is geth-compatible for most JSON-RPC behavior.
ETHEREUM_JSONRPC_VARIANT=geth

# Prefer WS for newHeads subscriptions (realtime indexer).
# RSKj WS port is enabled in docker/rskj/config.conf (4445 inside stack).
ETHEREUM_JSONRPC_WS_URL=ws://rskj:4445

# Be tolerant to slow/temporary RPC responses during cold start.
ETHEREUM_JSONRPC_HTTP_TIMEOUT=60

# Phoenix SECRET_KEY_BASE (Blockscout backend). This value is committed for reproducible LOCAL
# regtest only. Do NOT reuse for any shared/testnet/mainnet deployment — generate a strong secret
# and inject via env/secret manager instead.
SECRET_KEY_BASE=4e7b3fd34e37dd9ee1864a75a5e6c26a4d7a1a4aa65c6d6f5f16c9265e22c5f9b85e64c8b9b7c5d5a7c2f2e7d6b8a4e3d2c1b0a9f8e7d6c5b4a3f2e1d0c

# Indexer tuning (keep it lightweight)
DISABLE_EXCHANGE_RATES=true
DISABLE_KNOWN_TOKENS=true

# Regtest boot reliability: disable catchup indexer (historical backfill).
# On a fresh regtest chain, realtime indexing is enough, and catchup can trigger
# brittle JSON-RPC batching during early startup.
DISABLE_CATCHUP_INDEXER=true

# Rootstock regtest: be conservative with JSON-RPC batching.
# Some local nodes can return empty responses early in startup; smaller batches are more resilient.
ETH_JSON_RPC_MAX_BATCH_SIZE=1
INDEXER_CATCHUP_BLOCKS_BATCH_SIZE=1
INDEXER_CATCHUP_BLOCKS_CONCURRENCY=1
INDEXER_CATCHUP_MISSING_RANGES_BATCH_SIZE=1
INDEXER_RECEIPTS_BATCH_SIZE=1
INDEXER_COIN_BALANCES_BATCH_SIZE=1
INDEXER_INTERNAL_TRANSACTIONS_BATCH_SIZE=1

# Logging
LOG_LEVEL=${BLOCKSCOUT_LOG_LEVEL:-info}

# DB + JSON-RPC are set in docker-compose.yml so they can reference service names.

