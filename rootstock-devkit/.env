## Rootstock DevKit (docker-compose) configuration
##
## Ports
RSK_RPC_PORT=4444
RSK_P2P_PORT=5050
BLOCKSCOUT_PORT=4000
BLOCKSCOUT_API_PORT=4001
POSTGRES_PORT=5432

## Pinned images (bump deliberately)
RSKJ_IMAGE=rsksmart/rskj
RSKJ_TAG=REED-8.1.0

BLOCKSCOUT_RSK_IMAGE=ghcr.io/blockscout/blockscout-rsk
BLOCKSCOUT_RSK_TAG=9.0.2

BLOCKSCOUT_FRONTEND_IMAGE=ghcr.io/blockscout/frontend
# Pinned (not floating `latest`) — bump with backend compatibility in mind
BLOCKSCOUT_FRONTEND_TAG=v1.38.0

## RSKj runtime
# Lower is faster blocks (in ms). Used by the devkit config.
RSK_MINING_INTERVAL_MS=1000

## Postgres (Blockscout)
POSTGRES_DB=blockscout
POSTGRES_USER=blockscout
POSTGRES_PASSWORD=blockscout

## Optional: set to "debug" for more logs
BLOCKSCOUT_LOG_LEVEL=info

